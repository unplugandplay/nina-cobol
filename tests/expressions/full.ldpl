STRUCTURE Person
    name IS TEXT
    age IS NUMBER
END STRUCTURE

DATA:
result IS NUMBER
original IS NUMBER
message IS TEXT
person IS Person
people IS LIST OF Person

PROCEDURE
SET result TO CALCULATE-TOTAL(2, 3) + DOUBLE(4)
DISPLAY "total ", result, LF

SET result TO ADD(DOUBLE(2), ADD(3, 4))
DISPLAY "nested ", result, LF
SET result TO -2 + 3 * 4 % 5
DISPLAY "operators ", result, LF
SET result TO 1 / 2
DISPLAY "division ", result, LF
DISPLAY "factorial ", FACTORIAL(5), LF
DISPLAY "mutual ", IS-EVEN(4), LF

SET message TO GREET("Ada")
DISPLAY message, LF
SET message TO "literal" + " text"
DISPLAY message, LF

IF DOUBLE(5) = 10 AND NOT (ADD(1, 1) <> 2) AND "a" <= "b" THEN
    DISPLAY "condition", LF
END IF

SET person TO MAKE-PERSON("Lin", 29)
DISPLAY person:name, " ", person:age, LF
DISPLAY MAKE-PERSON("Bea", 22):name, LF
SET people TO SINGLETON(person)
PUSH MAKE-PERSON("Jo", 31) TO people
DISPLAY people:0:name, LF
DISPLAY people:1:name, LF

STORE 10 IN original
SET result TO INCREMENT-COPY(original)
DISPLAY result, " ", original, LF
SET result TO INCREMENT-REFERENCE(original)
DISPLAY result, " ", original, LF

CALL ADD-INTO WITH 7, DOUBLE(4), result
DISPLAY "call ", result, LF

TRY
    SET result TO MAYBE-RETURN(0)
ON ERROR
    DISPLAY "return error", LF
END TRY

SUB-PROCEDURE CALCULATE-TOTAL RETURNS NUMBER
PARAMETERS:
price IS NUMBER
quantity IS NUMBER
PROCEDURE
RETURN price * quantity
END SUB-PROCEDURE

SUB-PROCEDURE DOUBLE RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
RETURN value * 2
END SUB-PROCEDURE

SUB-PROCEDURE ADD RETURNS NUMBER
PARAMETERS:
left IS NUMBER
right IS NUMBER
PROCEDURE
RETURN left + right
END SUB-PROCEDURE

SUB-PROCEDURE FACTORIAL RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
IF value <= 1 THEN
    RETURN 1
END IF
RETURN value * FACTORIAL(value - 1)
END SUB-PROCEDURE

SUB-PROCEDURE MAYBE-RETURN RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
IF value = 1 THEN
    RETURN 1
END IF
END SUB-PROCEDURE

SUB-PROCEDURE IS-EVEN RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
IF value = 0 THEN
    RETURN 1
END IF
RETURN IS-ODD(value - 1)
END SUB-PROCEDURE

SUB-PROCEDURE IS-ODD RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
IF value = 0 THEN
    RETURN 0
END IF
RETURN IS-EVEN(value - 1)
END SUB-PROCEDURE

SUB-PROCEDURE GREET RETURNS TEXT
PARAMETERS:
name IS TEXT
PROCEDURE
RETURN "Hello, " + name + "!"
END SUB-PROCEDURE

SUB-PROCEDURE MAKE-PERSON RETURNS Person
PARAMETERS:
name IS TEXT
age IS NUMBER
LOCAL DATA:
made IS Person
PROCEDURE
STORE name IN made:name
STORE age IN made:age
RETURN made
END SUB-PROCEDURE

SUB-PROCEDURE SINGLETON RETURNS LIST OF Person
PARAMETERS:
value IS Person
LOCAL DATA:
result-list IS LIST OF Person
PROCEDURE
PUSH value TO result-list
RETURN result-list
END SUB-PROCEDURE

SUB-PROCEDURE INCREMENT-COPY RETURNS NUMBER
PARAMETERS:
value IS NUMBER
PROCEDURE
IN value SOLVE value + 1
RETURN value
END SUB-PROCEDURE

SUB-PROCEDURE INCREMENT-REFERENCE RETURNS NUMBER
PARAMETERS:
value IS REFERENCE NUMBER
PROCEDURE
IN value SOLVE value + 1
RETURN value
END SUB-PROCEDURE

SUB-PROCEDURE ADD-INTO
PARAMETERS:
left IS NUMBER
right IS NUMBER
destination IS NUMBER
PROCEDURE
IN destination SOLVE left + right
END SUB-PROCEDURE
